# ─── SmartFarm DakLak - Smart Control Configuration ───
# Copy to .env and fill in your values. Never commit .env to git.

# Server
PORT=3002

# MQTT
MQTT_URL=mqtt://localhost:1883

# JWT Authentication
# IMPORTANT: Change this in production!
JWT_SECRET=change-me-in-production

# InfluxDB (optional — service runs with in-memory fallback if not configured)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=smartfarm
INFLUXDB_BUCKET=soil_data

# Simulator (for development)
SIMULATOR_URL=http://localhost:3001
