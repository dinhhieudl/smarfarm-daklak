# SmartFarm Edge Sync Agent - Environment Variables
# Copy to .env and fill in your values

# InfluxDB connection
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=smartfarm
INFLUXDB_BUCKET=sensors

# Cloud platform
CLOUD_ENDPOINT=https://api.smartfarm.vn/v1/sync
CLOUD_MQTT_ENDPOINT=mqtts://mqtt.smartfarm.vn:8883
CLOUD_API_KEY=

# Device identity
DEVICE_ID=rpi-edge-001

# Sync behavior
SYNC_INTERVAL_MS=300000
SYNC_BATCH_SIZE=100
SYNC_PROTOCOL=https

# Logging
LOG_LEVEL=info

# Queue
QUEUE_DB_PATH=./data/sync-queue.db
