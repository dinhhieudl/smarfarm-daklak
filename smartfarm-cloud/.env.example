# SmartFarm Cloud Backend Configuration
NODE_ENV=production
PORT=3000

# PostgreSQL + TimescaleDB
DATABASE_URL=postgresql://smartfarm:CHANGE_ME@localhost:5432/smartfarm_cloud
DB_POOL_SIZE=20

# Redis
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=sf:

# MQTT (connection from ChirpStack edge agents)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=cloud_ingest
MQTT_PASSWORD=CHANGE_ME
MQTT_TOPIC_PREFIX=sensor/farm

# JWT
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHARS
JWT_EXPIRY=24h

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
