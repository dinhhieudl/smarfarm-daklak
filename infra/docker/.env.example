# ============================================================
# Environment Variables for Docker Compose
# Copy to .env and fill in your values
# ============================================================

# Docker Registry
DOCKER_REGISTRY=your-registry.example.com
DOCKER_IMAGE_WORKER=agritech/ingestion-worker
DOCKER_IMAGE_API=agritech/api-server
IMAGE_TAG=latest

# Database
DB_NAME=agritech
DB_USER=agritech_app
DB_PASSWORD=CHANGE_ME_APP_PASSWORD
DB_READONLY_PASSWORD=CHANGE_ME_READONLY_PASSWORD
DB_SUPERUSER=postgres
DB_SUPERUSER_PASSWORD=CHANGE_ME_SUPERUSER_PASSWORD

# MQTT
MQTT_HOST=0.0.0.0
MQTT_WORKER_USER=ingestion-worker
MQTT_WORKER_PASSWORD=CHANGE_ME_MQTT_PASSWORD
EMQX_ADMIN_USER=admin
EMQX_ADMIN_PASSWORD=CHANGE_ME_EMQX_PASSWORD

# AWS / S3
AWS_REGION=ap-southeast-1
S3_BUCKET=agritech-data-archive-production
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# API
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS
CORS_ORIGINS=https://dashboard.agritech.vn

# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# Hostname / Domain
MQTT_HOSTNAME=mqtt.agritech.vn
API_HOSTNAME=api.agritech.vn
