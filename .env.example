# ============================================================
# SmartFarm DakLak - Environment Configuration
# ============================================================
# FIRST: Generate secure secrets by running:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Then copy this file:  cp .env.example .env
# Edit .env with YOUR generated values before starting services.
# ============================================================

# ── MQTT ──
MQTT_URL=mqtt://localhost:1883

# ── InfluxDB ──
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=REPLACE_ME
INFLUXDB_INIT_ORG=smarfarm
INFLUXDB_INIT_BUCKET=soil_data
INFLUXDB_INIT_ADMIN_TOKEN=REPLACE_ME

# ── PostgreSQL (ChirpStack) ──
POSTGRES_USER=chirpstack
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=chirpstack

# ── Apache Superset ──
SUPERSET_SECRET_KEY=REPLACE_ME
SUPERSET_DB_PASSWORD=REPLACE_ME

# ── ChirpStack ──
CHIRPSTACK_JWT_SECRET=REPLACE_ME

# ── Application ──
JWT_SECRET=REPLACE_ME
ADMIN_PASSWORD=REPLACE_ME
OPERATOR_PASSWORD=REPLACE_ME
VIEWER_PASSWORD=REPLACE_ME
PORT=3002
TZ=Asia/Ho_Chi_Minh
