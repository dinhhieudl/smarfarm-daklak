# ============================================================
# SmartFarm DakLak - Environment Configuration
# Copy this file to .env and update values for your deployment
# ============================================================

# ── MQTT ──
MQTT_URL=mqtt://localhost:1883

# ── InfluxDB ──
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION
INFLUXDB_INIT_ORG=smarfarm
INFLUXDB_INIT_BUCKET=soil_data
INFLUXDB_INIT_ADMIN_TOKEN=CHANGE_ME_GENERATE_RANDOM_TOKEN

# ── PostgreSQL (ChirpStack) ──
POSTGRES_USER=chirpstack
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=chirpstack

# ── Grafana ──
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ── ChirpStack ──
CHIRPSTACK_JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET

# ── Application ──
PORT=3002
TZ=Asia/Ho_Chi_Minh

# ── JWT Auth ──
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET_IN_PRODUCTION
ADMIN_PASSWORD=admin123
OPERATOR_PASSWORD=operator123
VIEWER_PASSWORD=viewer123

# ── Telegram Notifications (Optional) ──
# Tạo bot qua @BotFather trên Telegram, lấy token
# Lấy chat_id: gửi tin nhắn cho bot, rồi GET https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── CORS (Optional) ──
# Comma-separated origins, hoặc * cho phép tất cả
# CORS_ORIGINS=https://your-domain.com
